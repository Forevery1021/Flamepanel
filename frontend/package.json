{
  "name": "ops-panel-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "npm run generate:api",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json}\"",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "locale:check": "node scripts/check-locale-keys.mjs",
    "analyze": "vite build --mode analyze",
    "openapi:generate": "node scripts/generate-api.mjs",
    "generate:api": "npm run openapi:generate",
    "prepare": "cd .. && husky",
    "commitlint": "commitlint --from origin/main --to HEAD",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preinstall": "node scripts/check-toolchain.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test:toolchain": "vitest run scripts/check-toolchain.spec.mjs"
  },
  "dependencies": {
    "@openvue/openicons": "^1.0.0-beta.1",
    "@openvue/themes": "^0.7.0-beta.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.8.4",
    "echarts": "^6.1.0",
    "openvue": "^0.7.0-beta.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.1",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.1"
  },
  "lint-staged": {
    "src/locales/**/*.ts": [
      "npm run locale:check"
    ],
    "*.{ts,vue,js,mjs,cjs,mts,cts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "undici": "^6.28.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
